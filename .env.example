# Names only: no values, no secrets. Copy to .env (docker compose) or .env.local (npm run dev) and fill in.
# In production every value comes from the Dokploy environment; secrets there are OpenBao references.
# Commented lines are optional: leave them commented to get the default (an empty value is NOT the default).

# ─── Postgres (docker compose) ────────────────────────────────
# Compose provisions the `db` service with these and builds the web service's DATABASE_URL from them.
# No default password: set a long random one (openssl rand -hex 32).
POSTGRES_PASSWORD=
# POSTGRES_USER=        (default extremspor)
# POSTGRES_DB=          (default extremspor)

# Server-side connection string for npm run dev: postgres://<user>:<password>@127.0.0.1:5432/<db>
# (compose sets its own for the web service).
DATABASE_URL=

# ─── Sessions ─────────────────────────────────────────────────
# Sessions are random tokens in the `sessions` table; SESSION_SECRET is passed through but not read yet.
SESSION_SECRET=
# SESSION_COOKIE_NAME=  (default extremspor_session)
# SESSION_COOKIE_SECURE=true   (only when served over HTTPS; browsers drop Secure cookies on http://localhost)

# ─── Admin access ─────────────────────────────────────────────
# Comma-separated admin emails; they share ADMIN_PASSWORD (long and random in production).
ADMIN_EMAILS=
ADMIN_PASSWORD=

# ─── Student access ───────────────────────────────────────────
# Comma-separated email domains allowed to sign up. Unset = any email.
# ALLOWED_EMAIL_DOMAINS=

# ─── Uploads ──────────────────────────────────────────────────
# Where evidence screenshots are stored (docker: /app/uploads, a named volume).
# UPLOADS_DIR=          (default ./uploads)
